# WEED Stratum bridge service
# Place at: /etc/systemd/system/weed-stratum.service
# Then:     sudo systemctl daemon-reload
#           sudo systemctl enable --now weed-stratum

[Unit]
Description=WEED merged-mining Stratum bridge
After=network.target

[Service]
Type=simple
User=weed
WorkingDirectory=/home/weed

# -- Point at your local WEED node RPC --
# If the node listens on 127.0.0.1:28332 with a token, use:
#   ExecStart=... --weed-url http://127.0.0.1:28332 --weed-token YOUR_RPC_TOKEN --payout-address S...
#
# For the public WEED node, the RPC is on localhost
# and the public node serves read-only methods without a token.  createauxblock
# and submitauxblock are MINING_METHODS though, so either:
#   a) start the node with --rpc-public-mining, or
#   b) use the node's RPC token.
#
# Option (b) is safer — keep mining methods behind the token.
Environment="RUST_LOG=info"
ExecStart=/home/weed/.local/bin/uv run python -m pool.weed_pool.server \
    --weed-url http://127.0.0.1:28332 \
    --weed-token YOUR_RPC_TOKEN_HERE \
    --payout-address YOUR_WEED_PAYOUT_ADDRESS_HERE \
    --host 0.0.0.0 \
    --port 3333 \
    --chain-id 1

Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/home/weed
ReadOnlyPaths=/

[Install]
WantedBy=multi-user.target